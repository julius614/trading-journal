# Copy to .env in the repo root (never commit it). Loaded automatically via python-dotenv.
MT5_LOGIN=12345678
MT5_PASSWORD=change-me
MT5_SERVER=YourBroker-Demo
MT5_TERMINAL_PATH=
# Broker server clock: ny_close (UTC+2 winter / +3 summer, most brokers), hours, or auto
MT5_SERVER_TIMEZONE=ny_close
STATARB_MAGIC=260330
# The pair to trade (y,x): both legs quoted in USD. Also supported: EURUSD,GBPUSD
STATARB_PAIR=AUDUSD,NZDUSD
# If your broker adds a suffix to symbol names (EURUSD.m), put it here: .m
STATARB_SYMBOL_SUFFIX=
# Account currency as shown in MT5 (USD, EUR, ...); non-USD accounts also read e.g. EURUSD
STATARB_ACCOUNT_CCY=USD
# y-leg notional as a multiple of equity (1.0 = equity-sized legs; ~2.0 max for prop accounts)
STATARB_NOTIONAL_MULT=1.0
# Round-trip commission per 1.0 lot per leg, in account currency
STATARB_COMMISSION_PER_LOT=7.0
# CSV of high-impact events (UTC) - required for --live unless the next line is 0
STATARB_REQUIRE_NEWS_CALENDAR=1
STATARB_NEWS_CSV=data/statarb_3leg/news_calendar.csv
# Prop-firm options (see knowledge-base/strategies/pairs-eurusd-gbpusd/prop-firm-plan.md)
# Fixed-risk sizing instead of the multiplier, e.g. 0.005 (off by default)
STATARB_RISK_PER_TRADE=
# Broker-side emergency stop per leg in pips (off to disable)
STATARB_EMERGENCY_SL_PIPS=250
# 1 = flat before the weekend (funded accounts that forbid weekend holding)
STATARB_FLAT_WEEKEND=0
# Minutes around high-impact news in which normal exits wait (FTMO funded: 2)
STATARB_NEWS_EXIT_BUFFER_MIN=
