# Copy to .env in the repo root (never commit it). Loaded automatically via python-dotenv.
MT5_LOGIN=12345678
MT5_PASSWORD=change-me
MT5_SERVER=YourBroker-Demo
MT5_TERMINAL_PATH=
# Broker server clock: ny_close (UTC+2 winter / +3 summer, most brokers), hours, or auto
MT5_SERVER_TIMEZONE=ny_close
STATARB_MAGIC=260330
# The pair to trade (y,x): both legs quoted in USD. Also supported: EURUSD,GBPUSD
STATARB_PAIR=AUDUSD,NZDUSD
# If your broker adds a suffix to symbol names (EURUSD.m), put it here: .m
STATARB_SYMBOL_SUFFIX=
STATARB_ACCOUNT_CCY=USD
# EUR notional per leg as a multiple of equity (1.0 = equity-sized legs)
STATARB_NOTIONAL_MULT=1.0
# Round-trip commission per 1.0 lot per leg, in account currency
STATARB_COMMISSION_PER_LOT=7.0
# CSV of high-impact events (UTC) - required for --live
STATARB_NEWS_CSV=data/statarb_3leg/news_calendar.csv
