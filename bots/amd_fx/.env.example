# Copy to .env (never commit it) or set these in your shell / service manager.
MT5_LOGIN=12345678
MT5_PASSWORD=change-me
MT5_SERVER=YourBroker-Demo
# Optional: path to terminal64.exe if more than one MT5 is installed
MT5_TERMINAL_PATH=
# Broker server time minus UTC in hours (e.g. 2 or 3). Leave empty to auto-detect
# from a live tick (market must be open).
MT5_SERVER_UTC_OFFSET=
MT5_MAGIC=260110
AMD_SYMBOLS=EURUSD,GBPUSD
AMD_TIMEFRAME=M5
