# Copy to .env (never commit it) or set these in your shell / service manager.
MT5_LOGIN=12345678
MT5_PASSWORD=change-me
MT5_SERVER=YourBroker-Demo
# Optional: path to terminal64.exe if more than one MT5 is installed
MT5_TERMINAL_PATH=
# How your broker's server clock relates to UTC:
#   ny_close  -> UTC+2 in winter, UTC+3 in summer (most FX brokers; check below)
#   3 or -5   -> a fixed offset in hours
#   auto      -> detect from a live tick (refused at weekends)
# Check: MT5 Market Watch shows server time; compare it with UTC (e.g. time.is/UTC).
MT5_SERVER_TIMEZONE=ny_close
MT5_MAGIC=260110
AMD_SYMBOLS=EURUSD,GBPUSD
AMD_TIMEFRAME=M5
